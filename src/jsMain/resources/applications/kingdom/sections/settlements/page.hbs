<div {{#if (ne currentNavEntry 'settlements')}}hidden{{/if}} class="km-kingdom-sheet-content">
    <div class="km-kingdom-sheet-sub-content km-kingdom-sheet-settlements">
        <section>
            <h2>{{localizeKM "kingdom.settlements"}}  <span class="km-header-right-align">

                <button type="button" data-action="create-settlement">{{localizeKM "kingdom.newSettlement"}}</button>

                <button type="button" data-action="add-settlement" {{#unless canAddCurrentSceneAsSettlement}}disabled{{/unless}}>{{localizeKM "kingdom.addCurrentScene"}}</button>

                <button type="button" data-action="settlement-size-info" title="{{localizeKM "kingdom.settlementSize"}}"><i class="fa-solid fa-circle-info"></i></button></span></h2>

            <div class="km-settlements-matrix-toggle">
                <button type="button" data-action="toggle-settlements-view" data-view="overview" {{#unless showDetailedMatrix}}class="km-active"{{/unless}}>{{localizeKM "kingdom.overview"}}</button>
                <button type="button" data-action="toggle-settlements-view" data-view="matrix" {{#if showDetailedMatrix}}class="km-active"{{/if}}>{{localizeKM "kingdom.detailedMatrix"}}</button>
            </div>

            {{#if showDetailedMatrix}}
            <table class="km-settlements-matrix">
                <thead>
                <tr>
                    <td>{{localizeKM "kingdom.statistic"}}</td>
                    {{#each settlements}}
                    <td>{{name}} {{#if isCapital}}<i class="fa-solid fa-star"></i>{{/if}}</td>
                    {{/each}}
                </tr>
                </thead>
                <tbody>
                <tr>
                    <td>{{localizeKM "applications.level"}}</td>
                    {{#each settlements}}
                    <td>{{level}}</td>
                    {{/each}}
                </tr>
                <tr>
                    <td>{{localizeKM "kingdom.population"}}</td>
                    {{#each settlements}}
                    <td>{{population}}</td>
                    {{/each}}
                </tr>
                <tr>
                    <td>{{localizeKM "kingdom.blocks"}}</td>
                    {{#each settlements}}
                    <td>{{blocks}}</td>
                    {{/each}}
                </tr>
                <tr>
                    <td>{{localizeKM "kingdom.lots"}}</td>
                    {{#each settlements}}
                    <td>{{lots}}</td>
                    {{/each}}
                </tr>
                <tr>
                    <td>{{localizeKM "kingdom.residentialLots"}}</td>
                    {{#each settlements}}
                    <td>{{residentialLots}}</td>
                    {{/each}}
                </tr>
                <tr>
                    <td>{{localizeKM "kingdom.overcrowded"}}</td>
                    {{#each settlements}}
                    <td>{{#if isOvercrowded}}<i class="fa-solid fa-people-roof" title="{{localizeKM "kingdom.overcrowded"}}"></i>{{else}}&mdash;{{/if}}</td>
                    {{/each}}
                </tr>
                <tr>
                    <td>{{localizeKM "kingdom.consumption"}}</td>
                    {{#each settlements}}
                    <td>{{consumption}}</td>
                    {{/each}}
                </tr>
                <tr>
                    <td>{{localizeKM "kingdom.maxItemBonus"}}</td>
                    {{#each settlements}}
                    <td>{{maxItemBonus}}</td>
                    {{/each}}
                </tr>
                <tr>
                    <td>{{localizeKM "kingdom.influence"}}</td>
                    {{#each settlements}}
                    <td>{{influence}}</td>
                    {{/each}}
                </tr>
                <tr class="km-matrix-section-header">
                    <td colspan="{{settlements.length}}">{{localizeKM "kingdom.itemLevels"}}</td>
                </tr>
                <tr>
                    <td>{{localizeKM "kingdom.baseItemLevel"}}</td>
                    {{#each settlements}}
                    <td>{{baseItemLevel}}</td>
                    {{/each}}
                </tr>
                <tr>
                    <td>{{localizeKM "kingdom.alchemicalItemLevel"}}</td>
                    {{#each settlements}}
                    <td>{{alchemicalItemLevel}}</td>
                    {{/each}}
                </tr>
                <tr>
                    <td>{{localizeKM "kingdom.magicItemLevel"}}</td>
                    {{#each settlements}}
                    <td>{{magicItemLevel}}</td>
                    {{/each}}
                </tr>
                <tr>
                    <td>{{localizeKM "kingdom.arcaneItemLevel"}}</td>
                    {{#each settlements}}
                    <td>{{arcaneItemLevel}}</td>
                    {{/each}}
                </tr>
                <tr>
                    <td>{{localizeKM "kingdom.divineItemLevel"}}</td>
                    {{#each settlements}}
                    <td>{{divineItemLevel}}</td>
                    {{/each}}
                </tr>
                <tr>
                    <td>{{localizeKM "kingdom.primalItemLevel"}}</td>
                    {{#each settlements}}
                    <td>{{primalItemLevel}}</td>
                    {{/each}}
                </tr>
                <tr>
                    <td>{{localizeKM "kingdom.luxuryItemLevel"}}</td>
                    {{#each settlements}}
                    <td>{{luxuryItemLevel}}</td>
                    {{/each}}
                </tr>
                <tr class="km-matrix-section-header">
                    <td colspan="{{settlements.length}}">Workbook Activity Bonuses</td>
                </tr>
                {{#each settlementDetailsRows}}
                <tr class="{{#if isHeader}}km-matrix-section-header{{/if}}" data-workbook-row="{{workbookRow}}">
                    <td>{{label}}</td>
                    {{#each cells}}
                    <td>{{value}}</td>
                    {{/each}}
                </tr>
                {{/each}}
                </tbody>
            </table>
            {{else}}
            <table>
                <thead>
                <tr>
                    <td>{{localizeKM "applications.name"}}</td>
                    <td>{{localizeKM "kingdom.size"}}</td>
                    <td>{{localizeKM "applications.level"}}</td>
                    <td>{{localizeKM "kingdom.residentialLots"}}</td>
                    <td>{{localizeKM "kingdom.issues"}}</td>
                    <td class="km-settlement-utilities-header">{{localizeKM "kingdom.utilities"}}</td>
                </tr>
                </thead>
                <tbody>
                {{#each settlements}}
                    <tr>
                        <td>{{name}} {{#if isCapital}}<i class="fa-solid fa-star"></i>{{/if}}</td>
                        <td>{{size}}</td>
                        <td>{{level}}</span></td>
                        <td>{{residentialLots}}</td>
                        <td>{{#if isOvercrowded}}<i class="fa-solid fa-people-roof" title="{{localizeKM "kingdom.overcrowded"}}"></i>{{/if}}
                        {{#if isSecondaryTerritory}}<i class="fa-solid fa-road-circle-xmark" title="{{localizeKM "kingdom.secondaryTerritory"}}"></i>{{/if}}
                        {{#if lacksBridge}}<i class="fa-solid fa-bridge-circle-xmark" title="{{localizeKM "kingdom.lacksBridge"}}"></i>{{/if}}</td>
                        <td class="km-settlement-utilities">
                            <button type="button" title="{{localizeKM "kingdom.view"}}" data-action="view-settlement" data-id="{{id}}">
                                <i class="fa-solid fa-eye"></i></button>
                            <button type="button" title="{{localizeKM "kingdom.activate"}}" data-action="activate-settlement" data-id="{{id}}">
                                <i class="fa-solid fa-bullseye"></i></button>
                            <button {{#unless isRigid}}hidden{{/unless}} type="button" data-action="level-up-settlement" data-id="{{id}}" data-level-up-to="{{canLevelUpTo}}" {{#unless canLevelUpTo}}disabled{{/unless}} {{#if nextLevelUp}} title="{{localizeKM "kingdom.canLevelUpTo" target=nextLevelUp}}"{{/if}}>
                                <i class="fa-solid fa-arrow-turn-up"></i>
                            </button>
                            <button {{# if isRigid}}hidden{{/if}} type="button" title="{{localizeKM "addSettlementBlock.title"}}" data-action="add-settlement-block" data-id="{{id}}">
                                <img alt="{{localizeKM "addSettlementBlock.title"}}" src="modules/pf2e-kingmaker-tools/img/settlements/block.webp"></button>
                            <button type="button" title="{{localizeKM "kingdom.details"}}" data-action="inspect-settlement" data-id="{{id}}">
                                <i class="fa-solid fa-magnifying-glass"></i></button>
                            <button type="button" title="{{localizeKM "kingdom.delete"}}" data-action="delete-settlement" data-id="{{id}}">
                            <i class="fa-solid fa-trash"></i>
                        </button></td>
                    </tr>
                {{/each}}
                </tbody>
            </table>
            {{/if}}
        </section>
    </div>
</div>
