<div class="km-browser">
{{#if showWorkbook}}
<h2>{{localizeKM "kingdom.armyRecruitmentBrowserTitle"}}</h2>
<table class="km-army-browser">
    <thead>
    <th>{{localizeKM "kingdom.army"}}</th>
    <th>{{localizeKM "applications.level"}}</th>
    <th>{{localizeKM "kingdom.armyType"}}</th>
    <th>{{localizeKM "applications.dc"}}</th>
    <th>{{localizeKM "kingdom.hp"}}</th>
    <th>{{localizeKM "kingdom.consumption"}}</th>
    <th>{{localizeKM "kingdom.attacks"}}</th>
    <th>{{localizeKM "kingdom.maneuverSave"}}</th>
    <th>{{localizeKM "kingdom.accessible"}}</th>
    <th>{{localizeKM "kingdom.startingTactics"}}</th>
    <th>{{localizeKM "applications.description"}}</th>
    </thead>
    <tbody>
    {{#each workbookArmies}}
        <tr>
            <td><strong>{{name}}</strong></td>
            <td>{{level}}</td>
            <td>{{type}}</td>
            <td>{{dc}}</td>
            <td>{{hp}}</td>
            <td>{{consumption}}</td>
            <td>{{attacks}}</td>
            <td>{{maneuverSave}}</td>
            <td>{{#if accessible}}<i class="fa-solid fa-circle-check"></i>{{else}}<i class="fa-solid fa-circle-xmark"></i>{{/if}}</td>
            <td>
                {{#if startingTactics.length}}
                    <ul class="km-tactics-list">
                    {{#each startingTactics}}
                        <li>{{this}}</li>
                    {{/each}}
                    </ul>
                {{else}}
                    —
                {{/if}}
            </td>
            <td>{{description}}</td>
        </tr>
    {{/each}}
    </tbody>
</table>
{{/if}}

<h2>{{localizeKM "kingdom.armyBrowserTitle"}}</h2>
<table>
    <thead>
    <th>{{localizeKM "kingdom.army"}}</th>
    <th>{{localizeKM "kingdom.armyType"}}</th>
    <th>{{localizeKM "applications.dc"}}</th>
    <th>{{localizeKM "kingdom.special"}}</th>
    <th>{{localizeKM "kingdom.recruit"}}</th>
    </thead>
    <tbody>
    {{#each armies}}
        <tr>
            <td>{{{link}}}</td>
            <td>{{type}}</td>
            <td>{{dc}}</td>
            <td>{{#if special}}<i class="fa-solid fa-circle-check"></i>{{/if}}</td>
            <td>
                <button type="button" data-action="recruit-army" data-uuid="{{uuid}}">{{localizeKM "kingdom.recruit"}}</button>
            </td>
        </tr>
    {{/each}}
    </tbody>
</table>
</div>
